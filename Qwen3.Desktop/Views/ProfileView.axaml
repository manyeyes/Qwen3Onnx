<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Qwen3.Desktop.Views.ProfileView"
             x:CompileBindings="False">
  <Grid Background="#F5F7FA">
    <ScrollViewer>
      <StackPanel Margin="30" Spacing="18">
      <StackPanel Spacing="5">
        <TextBlock Text="用户中心" FontSize="26" FontWeight="SemiBold" Foreground="#101828"/>
        <TextBlock Text="管理个人资料，并查看仅基于你自己的本地对话生成的使用画像。"
                   Foreground="#667085" TextWrapping="Wrap"/>
      </StackPanel>
      <Border Padding="22" Background="White" CornerRadius="16"
              BorderBrush="#E4E7EC" BorderThickness="1">
        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="20">
          <Border Width="76" Height="76" CornerRadius="38" Background="#EFF8FF"
                  BorderBrush="#B2DDFF" BorderThickness="1" VerticalAlignment="Top">
            <TextBlock Text="{Binding Initials}" FontSize="28" FontWeight="SemiBold"
                       Foreground="#175CD3" HorizontalAlignment="Center" VerticalAlignment="Center"/>
          </Border>
          <StackPanel Grid.Column="1" Spacing="6" VerticalAlignment="Center">
            <TextBlock Text="{Binding Profile.Nickname}" FontSize="22" FontWeight="SemiBold"
                       Foreground="#101828"/>
            <TextBlock Text="{Binding Profile.Username, StringFormat='账号：{0}'}"
                       Foreground="#667085"/>
            <TextBlock Text="{Binding AccountType}" Foreground="#175CD3"/>
          </StackPanel>
        </Grid>
      </Border>
      <Grid ColumnDefinitions="*,*" ColumnSpacing="18">
        <Border Padding="22" Background="White" CornerRadius="16"
                BorderBrush="#E4E7EC" BorderThickness="1">
          <StackPanel Spacing="13">
            <TextBlock Text="个人资料" FontSize="19" FontWeight="SemiBold" Foreground="#101828"/>
            <TextBox Text="{Binding Nickname}" MaxLength="60" PlaceholderText="昵称"/>
            <TextBox Text="{Binding AvatarUrl}" PlaceholderText="头像图片 URL（可选）"/>
            <TextBox Text="{Binding Birthday}" PlaceholderText="生日（yyyy-MM-dd，可选）"/>
            <TextBox Text="{Binding BlogUrl}" PlaceholderText="博客链接（可选）"/>
            <TextBox Text="{Binding Bio}" AcceptsReturn="True" TextWrapping="Wrap"
                     MinHeight="90" MaxLength="1000" PlaceholderText="介绍一下自己（最多 1000 字）"/>
            <Button Content="保存资料" Command="{Binding SaveProfileCommand}"
                    IsEnabled="{Binding IsNotBusy}"
                    HorizontalAlignment="Right" Padding="18,9"/>
          </StackPanel>
        </Border>
        <Border Grid.Column="1" Padding="22" Background="White" CornerRadius="16"
                BorderBrush="#E4E7EC" BorderThickness="1">
          <StackPanel Spacing="13">
            <TextBlock Text="修改密码" FontSize="19" FontWeight="SemiBold" Foreground="#101828"/>
            <TextBox Text="{Binding CurrentPassword}" PasswordChar="●" PlaceholderText="当前密码"/>
            <TextBox Text="{Binding NewPassword}" PasswordChar="●" PlaceholderText="新密码（至少 12 个字符）"/>
            <TextBox Text="{Binding ConfirmNewPassword}" PasswordChar="●" PlaceholderText="确认新密码"/>
            <Button Content="更新密码" Command="{Binding ChangePasswordCommand}"
                    IsEnabled="{Binding IsNotBusy}"
                    HorizontalAlignment="Right" Padding="18,9"/>
            <Border Margin="0,4,0,0" Padding="12" Background="#F9FAFB" CornerRadius="10">
              <TextBlock Text="{Binding StatusText}" Foreground="#475467" TextWrapping="Wrap"/>
            </Border>
          </StackPanel>
        </Border>
      </Grid>
      <Border Padding="22" Background="White" CornerRadius="16"
              BorderBrush="#E4E7EC" BorderThickness="1">
        <StackPanel Spacing="14">
          <StackPanel Spacing="4">
            <TextBlock Text="我的画像" FontSize="19" FontWeight="SemiBold" Foreground="#101828"/>
            <TextBlock Text="统计只读取当前账号的对话与 token 用量，不会用于查看其他账户内容。"
                       Foreground="#667085" TextWrapping="Wrap"/>
          </StackPanel>
          <Grid ColumnDefinitions="*,*,*" ColumnSpacing="12">
            <Border Padding="15" Background="#F9FAFB" CornerRadius="10">
              <StackPanel Spacing="4">
                <TextBlock Text="对话数" Foreground="#667085"/>
                <TextBlock Text="{Binding Insights.ConversationCount}" FontSize="24"
                           FontWeight="SemiBold" Foreground="#101828"/>
              </StackPanel>
            </Border>
            <Border Grid.Column="1" Padding="15" Background="#F9FAFB" CornerRadius="10">
              <StackPanel Spacing="4">
                <TextBlock Text="消息数" Foreground="#667085"/>
                <TextBlock Text="{Binding Insights.MessageCount}" FontSize="24"
                           FontWeight="SemiBold" Foreground="#101828"/>
              </StackPanel>
            </Border>
            <Border Grid.Column="2" Padding="15" Background="#EFF8FF" CornerRadius="10">
              <StackPanel Spacing="4">
                <TextBlock Text="累计 Tokens" Foreground="#175CD3"/>
                <TextBlock Text="{Binding Insights.TokensUsed, StringFormat='{}{0:N0}'}"
                           FontSize="24" FontWeight="SemiBold" Foreground="#175CD3"/>
              </StackPanel>
            </Border>
          </Grid>
          <StackPanel Spacing="8">
            <Grid ColumnDefinitions="*,Auto">
              <TextBlock Text="常见关键词" FontWeight="SemiBold" Foreground="#344054"/>
              <TextBlock Grid.Column="1" Text="按提问与回答词频动态展示"
                         FontSize="11" Foreground="#98A2B3"/>
            </Grid>
            <ItemsControl ItemsSource="{Binding KeywordCloudItems}"
                          IsVisible="{Binding HasKeywordInsights}">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                  <WrapPanel Orientation="Horizontal"/>
                </ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Border Margin="0,0,8,8" Padding="10,6" CornerRadius="16"
                          Background="{Binding Background}" ToolTip.Tip="{Binding FrequencyLabel}">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                      <TextBlock Text="{Binding Term}" FontSize="{Binding FontSize}"
                                 FontWeight="SemiBold" Foreground="{Binding Foreground}"/>
                      <TextBlock Text="{Binding Count}" FontSize="10" VerticalAlignment="Center"
                                 Foreground="{Binding Foreground}" Opacity="0.75"/>
                    </StackPanel>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <TextBlock Text="对话积累后，这里会根据提问与回答显示高频关键词。"
                       IsVisible="{Binding HasNoKeywordInsights}" Foreground="#667085"/>
          </StackPanel>
          <StackPanel Spacing="10">
            <TextBlock Text="领域分布" FontWeight="SemiBold" Foreground="#344054"/>
            <ItemsControl ItemsSource="{Binding Domains}">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Grid ColumnDefinitions="130,*,Auto" ColumnSpacing="12" Margin="0,3">
                    <TextBlock Text="{Binding Name}" Foreground="#475467" VerticalAlignment="Center"/>
                    <ProgressBar Grid.Column="1" Minimum="0" Maximum="100" Value="{Binding Percentage}"
                                 Height="8" VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="2" Text="{Binding Percentage, StringFormat='{}{0:F0}%'}"
                               Width="42" TextAlignment="Right" Foreground="#667085"
                               VerticalAlignment="Center"/>
                  </Grid>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <TextBlock Text="目前还没有足够的对话用于生成领域分布。"
                       IsVisible="{Binding HasNoDomainInsights}" Foreground="#667085"/>
          </StackPanel>
        </StackPanel>
      </Border>
      <Border Padding="18" Background="#FFFAF5" CornerRadius="14"
              BorderBrush="#FEDF89" BorderThickness="1"
              IsVisible="{Binding CanDeleteAccount}">
        <Grid ColumnDefinitions="*,Auto">
          <StackPanel Spacing="4">
            <TextBlock Text="注销账户" FontWeight="SemiBold" Foreground="#B54708"/>
            <TextBlock Text="注销后将删除该账户及其对话和资料，此操作不可撤销。"
                       Foreground="#7A2E0E" TextWrapping="Wrap"/>
          </StackPanel>
          <Button Grid.Column="1" Content="注销我的账户" Command="{Binding OpenDeleteConfirmationCommand}"
                  VerticalAlignment="Center" Background="#D92D20" Foreground="White" Padding="14,8"/>
        </Grid>
      </Border>
      </StackPanel>
    </ScrollViewer>
    <Border IsVisible="{Binding IsDeleteConfirmationOpen}" Background="#990F172A" ZIndex="20">
      <Border Width="440" Margin="20" Padding="26" Background="White" CornerRadius="16"
              HorizontalAlignment="Center" VerticalAlignment="Center">
        <StackPanel Spacing="14">
          <TextBlock Text="确认注销账户？" FontSize="21" FontWeight="SemiBold"
                     Foreground="#101828"/>
          <TextBlock Text="此操作会删除你的账户、个人资料和私有对话，且无法恢复。请输入当前密码确认。"
                     Foreground="#667085" TextWrapping="Wrap"/>
          <TextBox Text="{Binding DeletePassword}" PasswordChar="●" PlaceholderText="当前密码"/>
          <TextBlock Text="{Binding StatusText}" Foreground="#B42318" TextWrapping="Wrap"/>
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="10">
            <Button Content="取消" Command="{Binding CancelDeleteCommand}" Padding="14,8"/>
            <Button Content="确认注销" Command="{Binding ConfirmDeleteAccountCommand}"
                    IsEnabled="{Binding IsNotBusy}"
                    Background="#D92D20" Foreground="White" Padding="14,8"/>
          </StackPanel>
        </StackPanel>
      </Border>
    </Border>
  </Grid>
</UserControl>
