<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Qwen3.Desktop.ViewModels"
        xmlns:views="using:Qwen3.Desktop.Views"
        x:Class="Qwen3.Desktop.Views.MainWindow"
        x:CompileBindings="False"
        Title="Qwen3 ONNX"
        Width="1080" Height="720"
        MinWidth="760" MinHeight="520"
        WindowStartupLocation="CenterScreen">
  <Window.DataTemplates>
    <DataTemplate DataType="{x:Type vm:ChatPageViewModel}"><views:ChatView/></DataTemplate>
    <DataTemplate DataType="{x:Type vm:ModelsPageViewModel}"><views:ModelsView/></DataTemplate>
    <DataTemplate DataType="{x:Type vm:HistoryPageViewModel}"><views:ConversationManagementView/></DataTemplate>
    <DataTemplate DataType="{x:Type vm:UsersPageViewModel}"><views:UsersView/></DataTemplate>
    <DataTemplate DataType="{x:Type vm:ProfilePageViewModel}"><views:ProfileView/></DataTemplate>
    <DataTemplate DataType="{x:Type vm:AboutPageViewModel}"><views:AboutView/></DataTemplate>
  </Window.DataTemplates>
  <Window.Styles>
      <!-- 让 Button 的内容撑满，内部 StackPanel 才有空间对齐 -->
      <Style Selector="Button.nav-button">
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
      </Style>
      <!-- 展开态：图标 + 文字靠左 -->
      <Style Selector="Button.nav-button StackPanel">
        <Setter Property="HorizontalAlignment" Value="Left"/>
      </Style>
      <!-- 收起态：仅图标居中 -->
      <Style Selector="Button.nav-button.nav-collapsed StackPanel">
        <Setter Property="HorizontalAlignment" Value="Center"/>
      </Style>

      <!-- 标题栏 ☰ 样式保持不变 -->
      <Style Selector="Button.nav-header-button">
        <Setter Property="HorizontalAlignment" Value="Right"/>
      </Style>
      <Style Selector="Button.nav-header-button.nav-collapsed">
        <Setter Property="HorizontalAlignment" Value="Center"/>
      </Style>
  </Window.Styles>
  <Grid ColumnDefinitions="Auto,8,*" Background="#F5F7FA">

    <!-- ==================== 左侧导航栏 ==================== -->
    <Border Grid.Column="0" Width="{Binding SidebarWidth}" Background="#FFFFFF"
            BorderBrush="#E4E7EC" BorderThickness="0">
      <Grid RowDefinitions="Auto,*,Auto">

        <!-- ========== 顶部区域：展开/收起 + 新对话 + 模型管理 ========== -->
        <Border Grid.Row="0" Background="Transparent" BorderThickness="0" Padding="12">
          <StackPanel Spacing="7">

            <!-- 标题 + ☰：叠加布局，展开时标题左 / 按钮右，收起时按钮居中 -->
            <Grid Margin="4,6,4,12">
              <TextBlock Text="Qwen3" FontSize="21" FontWeight="Bold" Foreground="#175CD3"
                         HorizontalAlignment="Left" VerticalAlignment="Center"
                         IsVisible="{Binding IsSidebarExpanded}"/>
              <Button Content="☰" Command="{Binding ToggleSidebarCommand}"
                      Classes="nav-header-button"
                      Classes.nav-collapsed="{Binding !IsSidebarExpanded}"
                      Padding="8,5" Background="Transparent" BorderThickness="0"
                      Foreground="#344054"/>
            </Grid>

            <!-- 新对话 -->
            <Button Command="{Binding NewConversationCommand}"
                    Classes="nav-button"
                    Classes.nav-collapsed="{Binding !IsSidebarExpanded}"
                    Padding="12,10"
                    Background="#EFF8FF" Foreground="#175CD3" BorderBrush="#B2DDFF">
              <StackPanel Orientation="Horizontal" Spacing="9">
                <TextBlock Text="＋"/>
                <TextBlock Text="新对话" IsVisible="{Binding IsSidebarExpanded}"/>
              </StackPanel>
            </Button>

            <!-- 模型管理 -->
            <Button Command="{Binding NavigateToCommand}" CommandParameter="Models"
                    Classes="nav-button"
                    Classes.nav-collapsed="{Binding !IsSidebarExpanded}"
                    Padding="12,10"
                    Background="Transparent" Foreground="#344054" BorderThickness="0">
              <StackPanel Orientation="Horizontal" Spacing="9">
                <TextBlock Text="▦"/>
                <TextBlock Text="模型管理" IsVisible="{Binding IsSidebarExpanded}"/>
              </StackPanel>
            </Button>

          </StackPanel>
        </Border>

        <!-- ========== 中间区域：最近对话（自适应占满剩余空间） ========== -->
        <Grid Grid.Row="1" RowDefinitions="Auto,*" Margin="0,8,0,0" IsVisible="{Binding IsSidebarExpanded}">
          <TextBlock Text="最近对话" Margin="8,10,4,4" Padding="12,0" FontSize="12"
                     FontWeight="SemiBold" Foreground="#667085"/>
          <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                        HorizontalScrollBarVisibility="Disabled" Padding="12,0">
            <ItemsControl ItemsSource="{Binding History.Groups}">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <StackPanel Margin="4,8,0,4" Spacing="3">
                    <TextBlock Text="{Binding Title}" Margin="5,0,0,4" FontSize="11"
                               FontWeight="SemiBold" Foreground="#667085"/>
                    <ItemsControl ItemsSource="{Binding Conversations}">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate>
                          <Grid ColumnDefinitions="*,Auto">
                            <Button Command="{Binding OpenCommand}"
                                    HorizontalContentAlignment="Left"
                                    Padding="9,8" Margin="0,1" Background="Transparent"
                                    Foreground="#344054" BorderThickness="0" MinWidth="0"
                                    ToolTip.Tip="{Binding Title}">
                              <Grid ColumnDefinitions="Auto,*" ColumnSpacing="5">
                                <TextBlock Text="◆" IsVisible="{Binding IsPinned}"
                                           FontSize="10" Foreground="#175CD3"/>
                                <TextBlock Grid.Column="1" Text="{Binding Title}"
                                           TextTrimming="CharacterEllipsis"/>
                              </Grid>
                            </Button>
                            <Button Grid.Column="1" Content="⋯"
                                    Padding="5,2" Margin="0,1"
                                    Background="Transparent" BorderThickness="0"
                                    Foreground="#667085" ToolTip.Tip="对话操作">
                              <Button.Flyout>
                                <MenuFlyout Placement="Bottom">
                                  <MenuItem Header="{Binding PinMenuText}"
                                            Command="{Binding TogglePinCommand}"/>
                                  <MenuItem Header="重命名" Command="{Binding RenameCommand}"/>
                                  <MenuItem Header="删除" Command="{Binding DeleteCommand}"/>
                                </MenuFlyout>
                              </Button.Flyout>
                            </Button>
                          </Grid>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </StackPanel>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>
        </Grid>

        <!-- ========== 底部区域：用户登录 / 账户菜单（贴底停靠） ========== -->
        <Border Grid.Row="2" Background="Transparent" BorderThickness="0" Margin="0,8,0,0" Padding="12">
          <StackPanel Spacing="8" HorizontalAlignment="Stretch">

            <Border x:Name="BottomMenuBorder" IsVisible="{Binding IsBottomMenuOpen}"
                    Padding="7" Background="#FFFFFF"
                    CornerRadius="13" BorderBrush="#E4E7EC" BorderThickness="1"
                    HorizontalAlignment="Stretch">
              <StackPanel Spacing="3" HorizontalAlignment="Stretch">
                <Button Command="{Binding NavigateToCommand}" CommandParameter="Conversations"
                        IsVisible="{Binding IsLoggedIn}" HorizontalContentAlignment="Left"
                        Background="Transparent" BorderThickness="0" Padding="10,9"
                        Foreground="#344054">
                  <StackPanel Orientation="Horizontal" Spacing="10">
                    <TextBlock Text="▤"/><TextBlock Text="管理我的对话" IsVisible="{Binding IsSidebarExpanded}"/>
                  </StackPanel>
                </Button>
                <Button Command="{Binding NavigateToCommand}" CommandParameter="Profile"
                        IsVisible="{Binding IsLoggedIn}" HorizontalContentAlignment="Left"
                        Background="Transparent" BorderThickness="0" Padding="10,9"
                        Foreground="#344054">
                  <StackPanel Orientation="Horizontal" Spacing="10">
                    <TextBlock Text="◉"/><TextBlock Text="用户中心" IsVisible="{Binding IsSidebarExpanded}"/>
                  </StackPanel>
                </Button>
                <Button Command="{Binding NavigateToCommand}" CommandParameter="Users"
                        IsVisible="{Binding IsAdmin}" HorizontalContentAlignment="Left"
                        Background="Transparent" BorderThickness="0" Padding="10,9"
                        Foreground="#344054">
                  <StackPanel Orientation="Horizontal" Spacing="10">
                    <TextBlock Text="⚙"/><TextBlock Text="用户管理" IsVisible="{Binding IsSidebarExpanded}"/>
                  </StackPanel>
                </Button>
                <Button Command="{Binding OpenAuthenticationCommand}" IsVisible="{Binding IsGuest}"
                        HorizontalContentAlignment="Left" Background="Transparent" BorderThickness="0"
                        Padding="10,9" Foreground="#344054">
                  <StackPanel Orientation="Horizontal" Spacing="10">
                    <TextBlock Text="⇥"/><TextBlock Text="登录 / 注册" IsVisible="{Binding IsSidebarExpanded}"/>
                  </StackPanel>
                </Button>
                <Button Command="{Binding OpenWebsiteCommand}" HorizontalContentAlignment="Left"
                        Background="Transparent" BorderThickness="0" Padding="10,9"
                        Foreground="#344054">
                  <StackPanel Orientation="Horizontal" Spacing="10">
                    <TextBlock Text="↗"/><TextBlock Text="官网" IsVisible="{Binding IsSidebarExpanded}"/>
                  </StackPanel>
                </Button>
                <Button Command="{Binding OpenAboutPageCommand}" HorizontalContentAlignment="Left"
                        Background="Transparent" BorderThickness="0" Padding="10,9"
                        Foreground="#344054">
                  <StackPanel Orientation="Horizontal" Spacing="10">
                    <TextBlock Text="ⓘ"/><TextBlock Text="关于" IsVisible="{Binding IsSidebarExpanded}"/>
                  </StackPanel>
                </Button>
                <Button Command="{Binding SignOutCommand}" IsVisible="{Binding IsLoggedIn}"
                        HorizontalContentAlignment="Left" Background="Transparent" BorderThickness="0"
                        Padding="10,9" Foreground="#B42318">
                  <StackPanel Orientation="Horizontal" Spacing="10">
                    <TextBlock Text="⇤"/><TextBlock Text="退出登录" IsVisible="{Binding IsSidebarExpanded}"/>
                  </StackPanel>
                </Button>
              </StackPanel>
            </Border>

            <Button x:Name="BottomMenuButton" Command="{Binding ToggleBottomMenuCommand}" Padding="10,10"
                    HorizontalAlignment="Stretch"
                    Background="#F9FAFB" BorderBrush="#E4E7EC" CornerRadius="10"
                    HorizontalContentAlignment="Stretch">
              <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="9">
                <Border Width="30" Height="30" CornerRadius="15" Background="#EFF8FF">
                  <TextBlock Text="{Binding IdentityInitial}" FontSize="14" FontWeight="SemiBold"
                             Foreground="#175CD3" HorizontalAlignment="Center"
                             VerticalAlignment="Center"/>
                </Border>
                <StackPanel Grid.Column="1" VerticalAlignment="Center"
                            IsVisible="{Binding IsSidebarExpanded}">
                  <TextBlock Text="{Binding IdentityLabel}" FontSize="12" FontWeight="SemiBold"
                             Foreground="#344054" TextTrimming="CharacterEllipsis"/>
                  <TextBlock Text="账户与更多" FontSize="11" Foreground="#667085"/>
                </StackPanel>
                <TextBlock Grid.Column="2" Text="{Binding BottomMenuGlyph}"
                           Foreground="#667085" VerticalAlignment="Center"/>
              </Grid>
            </Button>
          </StackPanel>
        </Border>

      </Grid>
    </Border>

    <!-- ==================== 侧栏拖拽手柄 ==================== -->
    <Border Grid.Column="1" IsVisible="{Binding IsSidebarExpanded}"
            Background="Transparent" Cursor="SizeWestEast"
            PointerPressed="SidebarResizeHandle_OnPointerPressed"
            ToolTip.Tip="拖动调整导航栏宽度">
      <Border Width="1" Background="#EAECF0" HorizontalAlignment="Center"/>
    </Border>

    <!-- ==================== 主内容区 ==================== -->
    <ContentControl Grid.Column="2" Content="{Binding CurrentViewModel}" Margin="0"/>

    <!-- ==================== 重命名对话弹窗 ==================== -->
    <Border Grid.ColumnSpan="3" IsVisible="{Binding History.IsRenameDialogOpen}"
            Background="#990F172A" ZIndex="40">
      <Border Width="440" Margin="20" Padding="26" Background="White" CornerRadius="16"
              HorizontalAlignment="Center" VerticalAlignment="Center">
        <StackPanel Spacing="14">
          <TextBlock Text="重命名对话" FontSize="21" FontWeight="SemiBold"
                     Foreground="#101828"/>
          <TextBox Text="{Binding History.TitleDraft}" MaxLength="120"
                   PlaceholderText="请输入 1-120 个字符的标题"/>
          <TextBlock Text="{Binding History.StatusText}" Foreground="#B42318"
                     TextWrapping="Wrap"/>
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="10">
            <Button Content="取消" Command="{Binding History.CancelRenameCommand}" Padding="14,8"/>
            <Button Content="保存" Command="{Binding History.RenameSelectedCommand}"
                    Padding="14,8" Background="#175CD3" Foreground="White"/>
          </StackPanel>
        </StackPanel>
      </Border>
    </Border>

    <!-- ==================== 删除对话确认弹窗 ==================== -->
    <Border Grid.ColumnSpan="3" IsVisible="{Binding History.IsDeleteConfirmationOpen}"
            Background="#990F172A" ZIndex="41">
      <Border Width="440" Margin="20" Padding="26" Background="White" CornerRadius="16"
              HorizontalAlignment="Center" VerticalAlignment="Center">
        <StackPanel Spacing="14">
          <TextBlock Text="删除这段对话？" FontSize="21" FontWeight="SemiBold"
                     Foreground="#101828"/>
          <TextBlock Text="{Binding History.SelectedConversation.Title}" Foreground="#667085"
                     TextWrapping="Wrap"/>
          <TextBlock Text="删除后无法恢复。" Foreground="#B42318"/>
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="10">
            <Button Content="取消" Command="{Binding History.CancelDeleteCommand}" Padding="14,8"/>
            <Button Content="删除" Command="{Binding History.ConfirmDeleteRequestedCommand}"
                    Padding="14,8" Background="#D92D20" Foreground="White"/>
          </StackPanel>
        </StackPanel>
      </Border>
    </Border>

    <!-- ==================== 管理员账户一次性密码提示 ==================== -->
    <Border Grid.ColumnSpan="3" IsVisible="{Binding IsBootstrapNoticeVisible}"
            Background="#990F172A" ZIndex="20">
      <Border Width="520" Padding="28" CornerRadius="16" Background="White"
              HorizontalAlignment="Center" VerticalAlignment="Center">
        <StackPanel Spacing="12">
          <TextBlock Text="管理员账户已创建" FontSize="22" FontWeight="SemiBold"/>
          <TextBlock Text="请立即保存此一次性密码。关闭提示后程序不会再次显示；数据库仅保存密码哈希。"
                     TextWrapping="Wrap"/>
          <TextBox Text="{Binding GeneratedAdminPassword}" IsReadOnly="True"/>
          <TextBlock Text="用户名：admin" FontWeight="SemiBold"/>
          <Button Content="我已保存，继续使用" Command="{Binding DismissBootstrapNoticeCommand}"
                  HorizontalAlignment="Right" Padding="14,8"/>
        </StackPanel>
      </Border>
    </Border>

    <!-- ==================== 登录 / 注册弹窗 ==================== -->
    <Border Grid.ColumnSpan="3" IsVisible="{Binding IsAuthenticationOpen}"
            Background="#990F172A" ZIndex="30">
      <Border Width="420" Padding="28" CornerRadius="16" Background="White"
              HorizontalAlignment="Center" VerticalAlignment="Center">
        <StackPanel Spacing="12">
          <Grid ColumnDefinitions="*,Auto">
            <TextBlock Text="{Binding AuthenticationTitle}" FontSize="22" FontWeight="SemiBold"/>
            <Button Grid.Column="1" Content="×" Command="{Binding CloseAuthenticationCommand}"/>
          </Grid>
          <TextBox Text="{Binding LoginUsername}" PlaceholderText="用户名"/>
          <TextBox Text="{Binding LoginPassword}" PasswordChar="●" PlaceholderText="登录密码"
                   IsVisible="{Binding IsLoginMode}"/>
          <TextBox Text="{Binding RegisterPassword}" PasswordChar="●" PlaceholderText="密码（至少 12 个字符）"
                   IsVisible="{Binding IsRegisterMode}"/>
          <TextBox Text="{Binding RegisterConfirmPassword}" PasswordChar="●" PlaceholderText="再次输入密码"
                   IsVisible="{Binding IsRegisterMode}"/>
          <TextBlock Text="{Binding StatusMessage}" Foreground="#B42318" TextWrapping="Wrap"/>
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="10">
            <Button Content="{Binding AuthenticationToggleText}" Command="{Binding ToggleAuthenticationModeCommand}"
                    Padding="12,8"/>
            <Button Content="{Binding AuthenticationSubmitText}" Command="{Binding SignInCommand}"
                    IsVisible="{Binding IsLoginMode}"
                    Padding="18,8"/>
            <Button Content="{Binding AuthenticationSubmitText}" Command="{Binding RegisterCommand}"
                    IsVisible="{Binding IsRegisterMode}" Padding="18,8"/>
          </StackPanel>
        </StackPanel>
      </Border>
    </Border>

  </Grid>
</Window>