<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:md="using:Markdown.Avalonia"
             x:Class="Qwen3.Desktop.Views.ChatView"
             x:CompileBindings="False">
  <Grid RowDefinitions="Auto,*" Background="#FFFFFF">
    <!-- 顶部栏：白底，无分割线 -->
    <Border Padding="26,18" Background="White">
      <Grid ColumnDefinitions="*,Auto">
        <StackPanel>
          <TextBlock Text="{Binding ConversationTitle}" FontSize="21" FontWeight="SemiBold" Foreground="#101828"/>
          <TextBlock Text="{Binding StatusText}" Margin="0,5,0,0" Foreground="#667085" TextWrapping="Wrap"/>
        </StackPanel>
        <ComboBox Grid.Column="1" Width="250" ItemsSource="{Binding InstalledModels}"
                  SelectedItem="{Binding SelectedModel}" PlaceholderText="选择已安装模型"
                  IsEnabled="{Binding CanChangeConversation}">
          <ComboBox.ItemTemplate>
            <DataTemplate><TextBlock Text="{Binding Title}"/></DataTemplate>
          </ComboBox.ItemTemplate>
        </ComboBox>
      </Grid>
    </Border>

    <Grid Grid.Row="1" RowDefinitions="*,Auto">
      <!-- ========== 消息区：ScrollViewer + 悬浮滚到底按钮 ========== -->
      <Grid>
        <ScrollViewer x:Name="MessageScrollViewer"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      ScrollChanged="MessageScrollViewer_OnScrollChanged">
          <Grid>
            <ItemsControl ItemsSource="{Binding Messages}" Margin="30,24">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Grid ColumnDefinitions="*,Auto,Auto" Margin="0,0,0,18">
                    <StackPanel Grid.Column="{Binding BubbleColumn}"
                                Grid.ColumnSpan="{Binding BubbleColumnSpan}"
                                Spacing="5"
                                MaxWidth="{Binding BubbleMaxWidth}"
                                HorizontalAlignment="{Binding BubbleAlignment}"
                                Margin="{Binding BubbleMargin}">
                      <!-- 消息容器 -->
                      <Border CornerRadius="14"
                              Padding="{Binding BubblePadding}"
                              Background="{Binding BubbleBackground}"
                              BorderThickness="0">
                        <StackPanel Spacing="8">
                          <Border IsVisible="{Binding HasThinking}" Padding="10,8"
                                  Background="#F8FAFC" BorderBrush="#EAECF0" BorderThickness="1"
                                  CornerRadius="8">
                            <StackPanel Spacing="5">
                              <Grid ColumnDefinitions="*,Auto">
                                <TextBlock Text="思考过程" FontSize="12" FontWeight="SemiBold"
                                           Foreground="#667085" VerticalAlignment="Center"/>
                                <Button Grid.Column="1" Content="{Binding ThinkingToggleText}"
                                        Command="{Binding ToggleThinkingCommand}" Padding="8,3"/>
                              </Grid>
                              <ScrollViewer MaxHeight="{Binding ThinkingMaxHeight}"
                                            VerticalScrollBarVisibility="Hidden"
                                            HorizontalScrollBarVisibility="Disabled"
                                            ScrollChanged="ThinkingScrollViewer_OnScrollChanged">
                                <SelectableTextBlock Text="{Binding ThinkingContent}" TextWrapping="Wrap"
                                                     FontSize="13" Foreground="#667085"/>
                              </ScrollViewer>
                              <StackPanel Orientation="Horizontal" Spacing="8"
                                          IsVisible="{Binding IsPending}">
                                <ProgressBar Width="42" Height="4" IsIndeterminate="True"
                                             VerticalAlignment="Center"/>
                                <TextBlock Text="正在思考，持续显示最新内容…" FontSize="11"
                                           Foreground="#667085"/>
                              </StackPanel>
                            </StackPanel>
                          </Border>
                          <SelectableTextBlock Text="{Binding Content}" TextWrapping="Wrap"
                                               FontSize="15" Foreground="#344054"
                                               IsVisible="{Binding IsUser}"/>
                          <SelectableTextBlock Text="{Binding StreamingAnswer}" TextWrapping="Wrap"
                                               FontSize="15" Foreground="#344054"
                                               IsVisible="{Binding IsPending}"/>
                          <SelectableTextBlock Text="{Binding MarkdownContent}" TextWrapping="Wrap"
                                               FontSize="15" Foreground="#344054"
                                               IsVisible="{Binding IsTextSelectionMode}"/>
                          <md:MarkdownScrollViewer Markdown="{Binding MarkdownContent}"
                                                   IsVisible="{Binding IsMarkdownVisible}"/>
                          <Border IsVisible="{Binding WasInterrupted}" Padding="8,5"
                                  Background="#FFFAEB" CornerRadius="6" HorizontalAlignment="Left">
                            <TextBlock Text="{Binding InterruptionLabel}" FontSize="12"
                                       Foreground="#B54708"/>
                          </Border>
                          <TextBlock Text="{Binding AttachmentsText}" FontSize="12" Foreground="#667085"
                                     IsVisible="{Binding HasAttachments}"/>
                        </StackPanel>
                      </Border>
                      <!-- 消息操作按钮 -->
                      <StackPanel Orientation="Horizontal" Spacing="2"
                                  HorizontalAlignment="{Binding BubbleAlignment}">
                        <Button Content="⧉" ToolTip.Tip="复制消息"
                                Command="{Binding $parent[UserControl].DataContext.CopyMessageCommand}"
                                CommandParameter="{Binding}" Padding="8,4" FontSize="15"
                                Background="Transparent" BorderThickness="0" Foreground="#667085"/>
                        <Button Content="{Binding SelectionModeGlyph}"
                                ToolTip.Tip="{Binding SelectionModeTooltip}"
                                Command="{Binding ToggleTextSelectionModeCommand}"
                                IsVisible="{Binding IsAssistant}" Padding="8,4" FontSize="15"
                                Background="Transparent" BorderThickness="0" Foreground="#667085"/>
                        <Button Content="↗" ToolTip.Tip="重新发送"
                                Command="{Binding $parent[UserControl].DataContext.ResendMessageCommand}"
                                CommandParameter="{Binding}" IsVisible="{Binding IsUser}"
                                IsEnabled="{Binding $parent[UserControl].DataContext.CanChangeConversation}"
                                Padding="8,4" FontSize="15" Background="Transparent"
                                BorderThickness="0" Foreground="#667085"/>
                        <Button Content="↻" ToolTip.Tip="重新生成回复"
                                Command="{Binding $parent[UserControl].DataContext.RegenerateReplyCommand}"
                                CommandParameter="{Binding}" IsVisible="{Binding CanRegenerate}"
                                IsEnabled="{Binding $parent[UserControl].DataContext.CanChangeConversation}"
                                Padding="8,4" FontSize="15" Background="Transparent"
                                BorderThickness="0" Foreground="#667085"/>
                      </StackPanel>
                    </StackPanel>
                  </Grid>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <!-- 空状态提示 -->
            <StackPanel IsVisible="{Binding HasNoMessages}" HorizontalAlignment="Center"
                        VerticalAlignment="Center" Spacing="8" Margin="24">
              <TextBlock Text="开始一段新对话" FontSize="22" FontWeight="SemiBold"
                         Foreground="#344054" HorizontalAlignment="Center"/>
              <TextBlock Text="选择已安装模型，输入问题后即可开始。"
                         Foreground="#667085" HorizontalAlignment="Center"/>
            </StackPanel>
          </Grid>
        </ScrollViewer>

        <!-- 悬浮"滚动到底部"按钮：Border 包裹提供 BoxShadow，Button 提供点击 -->
        <Border x:Name="ScrollToBottomBorder"
                IsVisible="False"
                HorizontalAlignment="Center" VerticalAlignment="Bottom"
                Margin="0,0,0,18"
                Width="36" Height="36" CornerRadius="18"
                Background="White" BorderBrush="#E4E7EC" BorderThickness="1"
                BoxShadow="0 4 12 0 #1A101828">
          <Button x:Name="ScrollToBottomButton"
                  HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                  HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                  Padding="0" CornerRadius="18"
                  Background="Transparent" BorderThickness="0"
                  Foreground="#667085" FontSize="16"
                  ToolTip.Tip="滚动到底部"
                  Click="ScrollToBottomButton_OnClick">
            ↓
          </Button>
        </Border>
      </Grid>
      <!-- ========== 消息区结束 ========== -->

      <!-- 输入区：白底，无顶部分割线 -->
      <Border Grid.Row="1" Padding="22,16,22,20" Background="White" BorderThickness="0">
        <StackPanel Spacing="10">
          <StackPanel Spacing="6">
            <ItemsControl ItemsSource="{Binding AttachmentNames}">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate><WrapPanel Orientation="Horizontal"/></ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Border Margin="0,0,8,0" Padding="9,5" Background="#F2F4F7" CornerRadius="8">
                    <StackPanel Orientation="Horizontal" Spacing="7">
                      <TextBlock Text="{Binding}" Foreground="#344054"/>
                      <Button Content="×"
                              Command="{Binding $parent[Window].DataContext.Chat.RemoveAttachmentCommand}"
                              CommandParameter="{Binding}" Padding="4,0"/>
                    </StackPanel>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <TextBlock Text="{Binding AttachmentHint}"
                       FontSize="12" Foreground="#B42318"
                       TextWrapping="Wrap"
                       IsVisible="{Binding HasAttachmentHint}"/>
          </StackPanel>
          <Grid>
            <TextBox Text="{Binding InputText}" AcceptsReturn="True" TextWrapping="Wrap"
                     MinHeight="95" MaxHeight="210" IsEnabled="{Binding CanChangeConversation}"
                     PlaceholderText="输入消息…（支持文本与源码附件）"
                     Padding="10,10,10,26"
                     Background="White" BorderBrush="#D0D5DD" BorderThickness="1">
              <TextBox.KeyBindings>
                <KeyBinding Gesture="Enter" Command="{Binding SendFromKeyboardCommand}" />
              </TextBox.KeyBindings>
            </TextBox>
            <TextBlock Text="Enter 发送 · Shift+Enter 换行"
                       FontSize="11" Foreground="#98A2B3"
                       HorizontalAlignment="Right" VerticalAlignment="Bottom"
                       Margin="0,0,12,8"
                       IsHitTestVisible="False"/>
          </Grid>
          <Grid ColumnDefinitions="Auto,Auto,Auto,*,Auto">
            <Button Content="添加附件" Command="{Binding AddAttachmentsCommand}" Padding="12,8"
                    IsEnabled="{Binding CanChangeConversation}"/>
            <CheckBox Grid.Column="1" Content="思考模式" IsChecked="{Binding IsThinking}"
                      VerticalAlignment="Center" Margin="14,0" IsEnabled="{Binding CanChangeConversation}"/>
            <Button Grid.Column="2" Content="高级配置" Command="{Binding ToggleAdvancedCommand}"
                    Padding="12,8" IsEnabled="{Binding CanChangeConversation}"/>
            <TextBlock Grid.Column="3" Text="{Binding StatusText}" VerticalAlignment="Center"
                       Margin="12,0" Foreground="#667085" TextTrimming="CharacterEllipsis"/>
            <Button Grid.Column="4" Content="发送" Command="{Binding SendCommand}" Padding="22,8"
                    IsVisible="{Binding CanShowSend}" IsEnabled="{Binding CanSend}"/>
            <Button Grid.Column="4" Content="停止" Command="{Binding StopGenerationCommand}"
                    IsVisible="{Binding CanStop}" Background="#D92D20" Foreground="White"
                    Padding="22,8"/>
          </Grid>
        </StackPanel>
      </Border>

      <!-- 高级配置弹窗 -->
      <Border IsVisible="{Binding IsAdvancedOpen}" Grid.RowSpan="2" Background="#990F172A"
              HorizontalAlignment="Stretch" VerticalAlignment="Stretch" ZIndex="10">
        <Border Width="560" MaxHeight="680" Background="White" CornerRadius="16"
                BoxShadow="0 24 64 0 #33101828"
                HorizontalAlignment="Center" VerticalAlignment="Center">
          <Grid RowDefinitions="Auto,*,Auto">
            <Border Grid.Row="0" Padding="24,20,16,16"
                    BorderBrush="#EAECF0" BorderThickness="0,0,0,1">
              <Grid ColumnDefinitions="*,Auto">
                <StackPanel Spacing="4" VerticalAlignment="Center">
                  <TextBlock Text="生成参数" FontSize="18" FontWeight="SemiBold" Foreground="#101828"/>
                  <TextBlock Text="调整当前对话的生成行为，修改将应用于后续消息。"
                             FontSize="12" Foreground="#667085" TextWrapping="Wrap"/>
                </StackPanel>
                <Button Grid.Column="1" Content="×" Command="{Binding CloseAdvancedCommand}"
                        Width="32" Height="32" Padding="0" FontSize="18"
                        Background="Transparent" BorderThickness="0" Foreground="#667085"
                        HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                        VerticalAlignment="Top" ToolTip.Tip="关闭"/>
              </Grid>
            </Border>
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
              <StackPanel Margin="24,20,20,20" Spacing="18">
                <Grid ColumnDefinitions="120,*" ColumnSpacing="16"
                      RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto" RowSpacing="12">
                  <TextBlock Text="输出长度" VerticalAlignment="Center" FontSize="13" Foreground="#344054"/>
                  <NumericUpDown Grid.Column="1" Value="{Binding MaxNewTokens}" Minimum="1" Maximum="8192"/>
                  <TextBlock Grid.Row="1" Text="温度" VerticalAlignment="Center" FontSize="13" Foreground="#344054"/>
                  <NumericUpDown Grid.Row="1" Grid.Column="1" Value="{Binding Temperature}" Minimum="0" Maximum="2" Increment="0.05"/>
                  <TextBlock Grid.Row="2" Text="Top P" VerticalAlignment="Center" FontSize="13" Foreground="#344054"/>
                  <NumericUpDown Grid.Row="2" Grid.Column="1" Value="{Binding TopP}" Minimum="0" Maximum="1" Increment="0.05"/>
                  <TextBlock Grid.Row="3" Text="Top K" VerticalAlignment="Center" FontSize="13" Foreground="#344054"/>
                  <NumericUpDown Grid.Row="3" Grid.Column="1" Value="{Binding TopK}" Minimum="0" Maximum="200"/>
                  <TextBlock Grid.Row="4" Text="重复惩罚" VerticalAlignment="Center" FontSize="13" Foreground="#344054"/>
                  <NumericUpDown Grid.Row="4" Grid.Column="1" Value="{Binding RepetitionPenalty}" Minimum="0.1" Maximum="2" Increment="0.05"/>
                  <TextBlock Grid.Row="5" Text="思考预算" VerticalAlignment="Center" FontSize="13" Foreground="#344054"/>
                  <NumericUpDown Grid.Row="5" Grid.Column="1" Value="{Binding ThinkingBudget}" Minimum="0" Maximum="8192"/>
                  <TextBlock Grid.Row="6" Text="历史轮数" VerticalAlignment="Center" FontSize="13" Foreground="#344054"/>
                  <NumericUpDown Grid.Row="6" Grid.Column="1" Value="{Binding MaxHistoryTurns}" Minimum="0" Maximum="20"/>
                </Grid>
                <Border Height="1" Background="#F2F4F7"/>
                <StackPanel Spacing="10">
                  <CheckBox Content="启用采样" IsChecked="{Binding DoSample}"/>
                  <CheckBox Content="流式显示输出" IsChecked="{Binding StreamOutput}"/>
                </StackPanel>
              </StackPanel>
            </ScrollViewer>
            <Border Grid.Row="2" Padding="24,14,24,16"
                    BorderBrush="#EAECF0" BorderThickness="0,1,0,0"
                    Background="#F9FAFB" CornerRadius="0,0,16,16">
              <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="10">
                <Button Content="取消" Command="{Binding CloseAdvancedCommand}" Padding="18,8"
                        Background="Transparent" BorderBrush="#D0D5DD" Foreground="#344054"/>
                <Button Content="完成" Command="{Binding CloseAdvancedCommand}" Padding="22,8"
                        Background="#175CD3" Foreground="White" BorderThickness="0"/>
              </StackPanel>
            </Border>
          </Grid>
        </Border>
      </Border>

    </Grid>
  </Grid>
</UserControl>