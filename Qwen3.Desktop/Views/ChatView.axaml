<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:md="using:Markdown.Avalonia"
             x:Class="Qwen3.Desktop.Views.ChatView"
             x:CompileBindings="False">
  <Grid RowDefinitions="Auto,*" Background="#F5F7FA">
    <Border Padding="26,18" Background="White" BorderBrush="#E4E7EC" BorderThickness="0,0,0,1">
      <Grid ColumnDefinitions="*,Auto">
        <StackPanel>
          <TextBlock Text="{Binding ConversationTitle}" FontSize="21" FontWeight="SemiBold" Foreground="#101828"/>
          <TextBlock Text="{Binding StatusText}" Margin="0,5,0,0" Foreground="#667085" TextWrapping="Wrap"/>
        </StackPanel>
        <ComboBox Grid.Column="1" Width="250" ItemsSource="{Binding InstalledModels}"
                  SelectedItem="{Binding SelectedModel}" PlaceholderText="选择已安装模型"
                  IsEnabled="{Binding CanChangeConversation}">
          <ComboBox.ItemTemplate>
            <DataTemplate><TextBlock Text="{Binding Title}"/></DataTemplate>
          </ComboBox.ItemTemplate>
        </ComboBox>
      </Grid>
    </Border>
    <Grid Grid.Row="1" RowDefinitions="*,Auto">
      <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid>
          <ItemsControl ItemsSource="{Binding Messages}" Margin="30,24">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Border Margin="0,0,0,16" Padding="18,14" CornerRadius="14"
                        Background="White" BorderBrush="#EAECF0" BorderThickness="1">
                  <StackPanel Spacing="8">
                    <Grid ColumnDefinitions="*,Auto">
                      <TextBlock Text="{Binding DisplayRole}" FontSize="12" FontWeight="Bold"
                                 Foreground="#667085" VerticalAlignment="Center"/>
                      <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6">
                        <Button Content="复制" Command="{Binding $parent[UserControl].DataContext.CopyMessageCommand}"
                                CommandParameter="{Binding}" Padding="9,4"/>
                        <Button Content="重新发送"
                                Command="{Binding $parent[UserControl].DataContext.ResendMessageCommand}"
                                CommandParameter="{Binding}" IsVisible="{Binding IsUser}"
                                IsEnabled="{Binding $parent[UserControl].DataContext.CanChangeConversation}"
                                Padding="9,4"/>
                        <Button Content="重新生成回复"
                                Command="{Binding $parent[UserControl].DataContext.RegenerateReplyCommand}"
                                CommandParameter="{Binding}" IsVisible="{Binding CanRegenerate}"
                                IsEnabled="{Binding $parent[UserControl].DataContext.CanChangeConversation}"
                                Padding="9,4"/>
                      </StackPanel>
                    </Grid>
                    <Border IsVisible="{Binding HasThinking}" Padding="10,8"
                            Background="#F8FAFC" BorderBrush="#EAECF0" BorderThickness="1"
                            CornerRadius="8">
                      <StackPanel Spacing="5">
                        <Grid ColumnDefinitions="*,Auto">
                          <TextBlock Text="思考过程" FontSize="12" FontWeight="SemiBold"
                                     Foreground="#667085" VerticalAlignment="Center"/>
                          <Button Grid.Column="1" Content="{Binding ThinkingToggleText}"
                                  Command="{Binding ToggleThinkingCommand}" Padding="8,3"/>
                        </Grid>
                        <ScrollViewer MaxHeight="{Binding ThinkingMaxHeight}"
                                      VerticalScrollBarVisibility="Hidden"
                                      HorizontalScrollBarVisibility="Disabled"
                                      ScrollChanged="ThinkingScrollViewer_OnScrollChanged">
                          <TextBlock Text="{Binding ThinkingContent}" TextWrapping="Wrap"
                                     FontSize="13" Foreground="#667085"/>
                        </ScrollViewer>
                        <StackPanel Orientation="Horizontal" Spacing="8"
                                    IsVisible="{Binding IsPending}">
                          <ProgressBar Width="42" Height="4" IsIndeterminate="True"
                                       VerticalAlignment="Center"/>
                          <TextBlock Text="正在思考，持续显示最新内容…" FontSize="11"
                                     Foreground="#667085"/>
                        </StackPanel>
                      </StackPanel>
                    </Border>
                    <TextBlock Text="{Binding StreamingAnswer}" TextWrapping="Wrap"
                               FontSize="15" Foreground="#344054"
                               IsVisible="{Binding IsPending}"/>
                    <md:MarkdownScrollViewer Markdown="{Binding MarkdownContent}"
                                             IsVisible="{Binding IsNotPending}"/>
                    <TextBlock Text="{Binding AttachmentsText}" FontSize="12" Foreground="#667085"
                               IsVisible="{Binding HasAttachments}"/>
                  </StackPanel>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <StackPanel IsVisible="{Binding HasNoMessages}" HorizontalAlignment="Center"
                      VerticalAlignment="Center" Spacing="8" Margin="24">
            <TextBlock Text="开始一段新对话" FontSize="22" FontWeight="SemiBold"
                       Foreground="#344054" HorizontalAlignment="Center"/>
            <TextBlock Text="选择已安装模型，输入问题后即可开始。"
                       Foreground="#667085" HorizontalAlignment="Center"/>
          </StackPanel>
        </Grid>
      </ScrollViewer>
      <Border Grid.Row="1" Padding="22,16,22,20" Background="White"
              BorderBrush="#E4E7EC" BorderThickness="0,1,0,0">
        <StackPanel Spacing="10">
          <ItemsControl ItemsSource="{Binding AttachmentNames}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate><WrapPanel Orientation="Horizontal"/></ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Border Margin="0,0,8,0" Padding="9,5" Background="#F2F4F7" CornerRadius="8">
                  <StackPanel Orientation="Horizontal" Spacing="7">
                    <TextBlock Text="{Binding}" Foreground="#344054"/>
                    <Button Content="×"
                            Command="{Binding $parent[Window].DataContext.Chat.RemoveAttachmentCommand}"
                            CommandParameter="{Binding}" Padding="4,0"/>
                  </StackPanel>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <TextBox Text="{Binding InputText}" AcceptsReturn="True" TextWrapping="Wrap"
                   MinHeight="95" MaxHeight="210" IsEnabled="{Binding CanChangeConversation}"
                   PlaceholderText="输入消息…（支持文本与源码附件）"/>
          <Grid ColumnDefinitions="Auto,Auto,Auto,*,Auto">
            <Button Content="添加附件" Command="{Binding AddAttachmentsCommand}" Padding="12,8"
                    IsEnabled="{Binding CanChangeConversation}"/>
            <CheckBox Grid.Column="1" Content="思考模式" IsChecked="{Binding IsThinking}"
                      VerticalAlignment="Center" Margin="14,0" IsEnabled="{Binding CanChangeConversation}"/>
            <Button Grid.Column="2" Content="高级配置" Command="{Binding ToggleAdvancedCommand}"
                    Padding="12,8" IsEnabled="{Binding CanChangeConversation}"/>
            <TextBlock Grid.Column="3" Text="{Binding StatusText}" VerticalAlignment="Center"
                       Margin="12,0" Foreground="#667085" TextTrimming="CharacterEllipsis"/>
            <Button Grid.Column="4" Content="发送" Command="{Binding SendCommand}" Padding="22,8"
                    IsVisible="{Binding CanShowSend}" IsEnabled="{Binding CanSend}"/>
            <Button Grid.Column="4" Content="停止" Command="{Binding StopGenerationCommand}"
                    IsVisible="{Binding CanStop}" Background="#D92D20" Foreground="White"
                    Padding="22,8"/>
          </Grid>
        </StackPanel>
      </Border>
      <Border IsVisible="{Binding IsAdvancedOpen}" Grid.RowSpan="2" Background="#990F172A"
              HorizontalAlignment="Stretch" VerticalAlignment="Stretch" ZIndex="10">
        <Border Width="560" MaxHeight="680" Padding="26" Background="White" CornerRadius="16"
                HorizontalAlignment="Center" VerticalAlignment="Center">
          <ScrollViewer>
            <StackPanel Spacing="13">
              <Grid ColumnDefinitions="*,Auto">
                <TextBlock Text="生成参数" FontSize="22" FontWeight="SemiBold" Foreground="#101828"/>
                <Button Grid.Column="1" Content="关闭" Command="{Binding CloseAdvancedCommand}"/>
              </Grid>
              <TextBlock Text="输出长度"/><NumericUpDown Value="{Binding MaxNewTokens}" Minimum="1" Maximum="8192"/>
              <TextBlock Text="温度"/><NumericUpDown Value="{Binding Temperature}" Minimum="0" Maximum="2" Increment="0.05"/>
              <TextBlock Text="Top P"/><NumericUpDown Value="{Binding TopP}" Minimum="0" Maximum="1" Increment="0.05"/>
              <TextBlock Text="Top K"/><NumericUpDown Value="{Binding TopK}" Minimum="0" Maximum="200"/>
              <TextBlock Text="重复惩罚"/><NumericUpDown Value="{Binding RepetitionPenalty}" Minimum="0.1" Maximum="2" Increment="0.05"/>
              <TextBlock Text="思考预算"/><NumericUpDown Value="{Binding ThinkingBudget}" Minimum="0" Maximum="8192"/>
              <TextBlock Text="历史轮数"/><NumericUpDown Value="{Binding MaxHistoryTurns}" Minimum="0" Maximum="20"/>
              <CheckBox Content="启用采样" IsChecked="{Binding DoSample}"/>
              <CheckBox Content="流式显示输出" IsChecked="{Binding StreamOutput}"/>
              <Button Content="完成" Command="{Binding CloseAdvancedCommand}" HorizontalAlignment="Right"/>
            </StackPanel>
          </ScrollViewer>
        </Border>
      </Border>
    </Grid>
  </Grid>
</UserControl>
