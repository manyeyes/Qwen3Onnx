<Project Sdk="Microsoft.NET.Sdk">
		<PropertyGroup>
				<TargetFramework>net9.0</TargetFramework>
				<ImplicitUsings>enable</ImplicitUsings>
				<Nullable>enable</Nullable>

				<AssemblyName>Qwen3.Inference</AssemblyName>
				<RootNamespace>Qwen3.Inference</RootNamespace>
				<Title>Qwen3 Inference</Title>
				<Description>Qwen3 ONNX inference core library based on OnnxRuntime and Tokenizers.DotNet</Description>
				<Authors>manyeyes and contributors</Authors>
				<Version>0.3.0</Version>
				<AssemblyVersion>0.3.0.0</AssemblyVersion>
				<FileVersion>0.3.0.0</FileVersion>
				<Copyright>Copyright © manyeyes and contributors 2026</Copyright>
				<RepositoryUrl>https://github.com/manyeyes/Qwen3Onnx</RepositoryUrl>
				<RepositoryType>git</RepositoryType>

				<OutputType>Library</OutputType>
				<GeneratePackageOnBuild>false</GeneratePackageOnBuild>
				<AllowUnsafeBlocks>true</AllowUnsafeBlocks>
				<EnableTrim>false</EnableTrim>
				<TrimMode>partial</TrimMode>
				<InferenceBackend Condition="'$(InferenceBackend)' == ''">Gpu</InferenceBackend>
				<CudaVersion Condition="'$(CudaVersion)' == ''">12</CudaVersion>
		</PropertyGroup>
		<PropertyGroup Condition="'$(InferenceBackend)' == 'Gpu'">
				<DefineConstants>$(DefineConstants);INFERENCE_BACKEND_GPU</DefineConstants>
		</PropertyGroup>
		<ItemGroup>
		  <Compile Remove="OnnxInferenceChatTemplateGenaiEngine - 复制%282%29.cs" />
		  <Compile Remove="OnnxInferenceChatTemplateGenaiEngine - 复制.cs" />
		  <Compile Remove="OnnxInferenceDeepSeekGenaiEngine - 复制.cs" />
		  <Compile Remove="OnnxInferenceEngine - 复制%282%29.cs" />
		  <Compile Remove="OnnxInferenceEngine - 复制.cs" />
		  <Compile Remove="OnnxInferenceGenaiEngine - 复制.cs" />
		  <Compile Remove="OnnxInferenceLlamaGenaiEngine - 复制%282%29.cs" />
		  <Compile Remove="OnnxInferenceLlamaGenaiEngine - 复制%283%29.cs" />
		  <Compile Remove="OnnxInferenceLlamaGenaiEngine - 复制%284%29.cs" />
		  <Compile Remove="OnnxInferenceLlamaGenaiEngine - 复制.cs" />
		</ItemGroup>

		<ItemGroup>
				<PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="9.0.0" />
				<PackageReference Include="Microsoft.ML.OnnxRuntime" Version="1.31.0" Condition="'$(InferenceBackend)' == 'Cpu'" />
				<PackageReference Include="Microsoft.ML.OnnxRuntimeGenAI" Version="0.18.0" Condition="'$(InferenceBackend)' == 'Cpu'" />
				<PackageReference Include="Microsoft.ML.OnnxRuntime.Gpu" Version="1.26.0" Condition="'$(InferenceBackend)' == 'Gpu' and '$(CudaVersion)' == '12'" />
				<PackageReference Include="Microsoft.ML.OnnxRuntimeGenAI.Cuda" Version="0.14.1" Condition="'$(InferenceBackend)' == 'Gpu' and '$(CudaVersion)' == '12'" />
				<PackageReference Include="Microsoft.ML.OnnxRuntime.Gpu" Version="1.31.0" Condition="'$(InferenceBackend)' == 'Gpu' and '$(CudaVersion)' == '13'" />
				<PackageReference Include="Microsoft.ML.OnnxRuntimeGenAI.Cuda" Version="0.18.0" Condition="'$(InferenceBackend)' == 'Gpu' and '$(CudaVersion)' == '13'" />
				<PackageReference Include="Tokenizers.DotNet" Version="1.4.1" />
				<PackageReference Include="Tokenizers.DotNet.runtime.win-x64" Version="1.4.1" />
				<PackageReference Include="Tokenizers.DotNet.runtime.linux-x64" Version="1.4.1" />
				<PackageReference Include="Tokenizers.DotNet.runtime.linux-arm64" Version="1.4.1" />
				<PackageReference Include="Tokenizers.DotNet.runtime.osx-x64" Version="1.4.1" />
				<PackageReference Include="Tokenizers.DotNet.runtime.osx-arm64" Version="1.4.1" />
		</ItemGroup>
		<Target Name="ValidateInferenceBackend" BeforeTargets="PrepareForBuild">
				<Error Condition="'$(InferenceBackend)' != 'Cpu' and '$(InferenceBackend)' != 'Gpu'" Text="InferenceBackend must be either Cpu or Gpu." />
				<Error Condition="'$(InferenceBackend)' == 'Gpu' and '$(CudaVersion)' != '12' and '$(CudaVersion)' != '13'" Text="CudaVersion must be either 12 or 13 when InferenceBackend=Gpu." />
		</Target>
</Project>
