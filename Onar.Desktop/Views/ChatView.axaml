<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:md="using:Markdown.Avalonia"
             xmlns:materialIcons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             xmlns:icons="clr-namespace:Material.Icons;assembly=Material.Icons"
             xmlns:conv="clr-namespace:Onar.Desktop.Converters"
             x:Class="Onar.Desktop.Views.ChatView"
             x:CompileBindings="False">
  <Grid RowDefinitions="Auto,*" Background="#FFFFFF">
    <!-- 顶部栏 -->
    <Border Padding="26,18" Background="White">
      <Grid ColumnDefinitions="*">
        <StackPanel>
          <TextBlock Text="{Binding ConversationTitle}" FontSize="21" FontWeight="SemiBold" Foreground="#101828"/>
        </StackPanel>
      </Grid>
    </Border>

    <Grid Grid.Row="1" RowDefinitions="*,Auto">
      <!-- ========== 消息区 ========== -->
      <Grid>
        <ScrollViewer x:Name="MessageScrollViewer"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      ScrollChanged="MessageScrollViewer_OnScrollChanged">
          <Grid>
            <ItemsControl ItemsSource="{Binding Messages}" Margin="30,24">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Grid ColumnDefinitions="*,Auto,Auto" Margin="0,0,0,18">
                    <StackPanel Grid.Column="{Binding BubbleColumn}"
                                Grid.ColumnSpan="{Binding BubbleColumnSpan}"
                                Spacing="5"
                                MaxWidth="{Binding BubbleMaxWidth}"
                                HorizontalAlignment="{Binding BubbleAlignment}"
                                Margin="{Binding BubbleMargin}">
                      <Border CornerRadius="14"
                              Padding="{Binding BubblePadding}"
                              Background="{Binding BubbleBackground}"
                              BorderThickness="0">
                        <StackPanel Spacing="8">
                          <Border IsVisible="{Binding HasThinking}" Padding="10,8"
                                  Background="#F8FAFC" BorderBrush="#EAECF0" BorderThickness="1"
                                  CornerRadius="8">
                            <StackPanel Spacing="5">
                              <Grid ColumnDefinitions="*,Auto">
                                <TextBlock Text="思考过程" FontSize="12" FontWeight="SemiBold"
                                           Foreground="#667085" VerticalAlignment="Center"/>
                                <Button Grid.Column="1" Content="{Binding ThinkingToggleText}"
                                        Command="{Binding ToggleThinkingCommand}" Padding="8,3"/>
                              </Grid>
                              <ScrollViewer MaxHeight="{Binding ThinkingMaxHeight}"
                                            VerticalScrollBarVisibility="Hidden"
                                            HorizontalScrollBarVisibility="Disabled"
                                            ScrollChanged="ThinkingScrollViewer_OnScrollChanged">
                                <SelectableTextBlock Text="{Binding ThinkingContent}" TextWrapping="Wrap"
                                                     FontSize="13" Foreground="#667085"/>
                              </ScrollViewer>
                              <StackPanel Orientation="Horizontal" Spacing="8"
                                          IsVisible="{Binding IsPending}">
                                <ProgressBar Width="42" Height="4" IsIndeterminate="True"
                                             VerticalAlignment="Center"/>
                                <TextBlock Text="正在思考，持续显示最新内容…" FontSize="11"
                                           Foreground="#667085"/>
                              </StackPanel>
                            </StackPanel>
                          </Border>
                          <SelectableTextBlock Text="{Binding Content}" TextWrapping="Wrap"
                                               FontSize="15" Foreground="#344054"
                                               IsVisible="{Binding IsUser}"/>
                          <SelectableTextBlock Text="{Binding StreamingAnswer}" TextWrapping="Wrap"
                                               FontSize="15" Foreground="#344054"
                                               IsVisible="{Binding IsPending}"/>
                          <SelectableTextBlock Text="{Binding MarkdownContent}" TextWrapping="Wrap"
                                               FontSize="15" Foreground="#344054"
                                               IsVisible="{Binding IsTextSelectionMode}"/>
                          <md:MarkdownScrollViewer Markdown="{Binding MarkdownContent}"
                                                   IsVisible="{Binding IsMarkdownVisible}"/>
                          <Border IsVisible="{Binding WasInterrupted}" Padding="8,5"
                                  Background="#FFFAEB" CornerRadius="6" HorizontalAlignment="Left">
                            <TextBlock Text="{Binding InterruptionLabel}" FontSize="12"
                                       Foreground="#B54708"/>
                          </Border>
                          <TextBlock Text="{Binding AttachmentsText}" FontSize="12" Foreground="#667085"
                                     IsVisible="{Binding HasAttachments}"/>
                        </StackPanel>
                      </Border>
                      <StackPanel Orientation="Horizontal" Spacing="2"
                                  HorizontalAlignment="{Binding BubbleAlignment}">
                        <Button ToolTip.Tip="复制消息"
                                Command="{Binding $parent[UserControl].DataContext.CopyMessageCommand}"
                                CommandParameter="{Binding}" Padding="7,4" Width="30" Height="30"
                                Background="Transparent" BorderThickness="0" Foreground="#667085">
                          <materialIcons:MaterialIcon Kind="{x:Static icons:MaterialIconKind.ContentCopy}"
                                                      Width="16" Height="16"/>
                        </Button>
                        <Button ToolTip.Tip="{Binding GenerationStatsTooltip}"
                                IsVisible="{Binding HasGenerationStats}"
                                Padding="7,4" Width="30" Height="30"
                                Background="Transparent" BorderThickness="0" Foreground="#667085">
                          <materialIcons:MaterialIcon Kind="{x:Static icons:MaterialIconKind.InformationOutline}"
                                                      Width="16" Height="16"/>
                        </Button>
                        <Button ToolTip.Tip="删除消息"
                                Command="{Binding $parent[UserControl].DataContext.DeleteMessageCommand}"
                                CommandParameter="{Binding}" IsVisible="{Binding CanDelete}"
                                IsEnabled="{Binding $parent[UserControl].DataContext.CanChangeConversation}"
                                Padding="7,4" Width="30" Height="30" Background="Transparent"
                                BorderThickness="0" Foreground="#667085">
                          <materialIcons:MaterialIcon Kind="{x:Static icons:MaterialIconKind.DeleteOutline}"
                                                      Width="16" Height="16"/>
                        </Button>
                        <Button ToolTip.Tip="{Binding SelectionModeTooltip}"
                                Command="{Binding ToggleTextSelectionModeCommand}"
                                IsVisible="{Binding IsAssistant}" Padding="7,4" Width="30" Height="30"
                                Background="Transparent" BorderThickness="0" Foreground="#667085">
                          <Grid>
                            <materialIcons:MaterialIcon Kind="{x:Static icons:MaterialIconKind.TextBoxOutline}"
                                                        Width="16" Height="16" IsVisible="{Binding !IsTextSelectionMode}"/>
                            <materialIcons:MaterialIcon Kind="{x:Static icons:MaterialIconKind.LanguageMarkdown}"
                                                        Width="16" Height="16" IsVisible="{Binding IsTextSelectionMode}"/>
                          </Grid>
                        </Button>
                        <Button ToolTip.Tip="重新发送"
                                Command="{Binding $parent[UserControl].DataContext.ResendMessageCommand}"
                                CommandParameter="{Binding}" IsVisible="{Binding IsUser}"
                                IsEnabled="{Binding $parent[UserControl].DataContext.CanChangeConversation}"
                                Padding="7,4" Width="30" Height="30" Background="Transparent"
                                BorderThickness="0" Foreground="#667085">
                          <materialIcons:MaterialIcon Kind="{x:Static icons:MaterialIconKind.SendOutline}"
                                                      Width="16" Height="16"/>
                        </Button>
                        <Button ToolTip.Tip="重新生成回复"
                                Command="{Binding $parent[UserControl].DataContext.RegenerateReplyCommand}"
                                CommandParameter="{Binding}" IsVisible="{Binding CanRegenerate}"
                                IsEnabled="{Binding $parent[UserControl].DataContext.CanChangeConversation}"
                                Padding="7,4" Width="30" Height="30" Background="Transparent"
                                BorderThickness="0" Foreground="#667085">
                          <materialIcons:MaterialIcon Kind="{x:Static icons:MaterialIconKind.Refresh}"
                                                      Width="16" Height="16"/>
                        </Button>
                      </StackPanel>
                    </StackPanel>
                  </Grid>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <StackPanel IsVisible="{Binding HasNoMessages}" HorizontalAlignment="Center"
                        VerticalAlignment="Center" Spacing="8" Margin="24">
              <TextBlock Text="开始一段新对话" FontSize="22" FontWeight="SemiBold"
                         Foreground="#344054" HorizontalAlignment="Center"/>
              <TextBlock Text="选择已安装模型，输入问题后即可开始。"
                         Foreground="#667085" HorizontalAlignment="Center"/>
            </StackPanel>
          </Grid>
        </ScrollViewer>

        <Border x:Name="ScrollToBottomBorder"
                IsVisible="False"
                HorizontalAlignment="Center" VerticalAlignment="Bottom"
                Margin="0,0,0,18"
                Width="36" Height="36" CornerRadius="18"
                Background="White" BorderBrush="#E4E7EC" BorderThickness="1"
                BoxShadow="0 4 12 0 #1A101828">
          <Button x:Name="ScrollToBottomButton"
                  HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                  HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                  Padding="0" CornerRadius="18"
                  Background="Transparent" BorderThickness="0"
                  Foreground="#667085" FontSize="16"
                  ToolTip.Tip="滚动到底部"
                  Click="ScrollToBottomButton_OnClick">
            <materialIcons:MaterialIcon Kind="{x:Static icons:MaterialIconKind.ChevronDown}"
                                        Width="18" Height="18"/>
          </Button>
        </Border>
      </Grid>

            <!-- ========== 输入区：TextBox 填满 Border，边框与 Border 重合 ========== -->
      <!-- 附件区浮顶、工具栏浮底，TextBox 的 Padding.Top 动态跟随附件区高度，避免遮挡 -->
      <Border Grid.Row="1" Margin="22,10,22,12"
              Background="White" BorderBrush="#D0D5DD" BorderThickness="1"
              CornerRadius="13" ClipToBounds="True">
        <Grid>

          <!-- TextBox：填满整个 Border 区域；边框与 Border 完全重合 -->
          <!-- Padding.Top 绑定 AttachmentOverlay.Bounds.Height 经转换器计算 -->
          <TextBox Name="InputTextBox"
                   Text="{Binding InputText}" AcceptsReturn="True" TextWrapping="Wrap"
                   MinHeight="88" MaxHeight="220" IsEnabled="{Binding CanChangeConversation}"
                   PlaceholderText="输入消息…（支持文本与源码附件）"
                   Padding="{Binding #AttachmentOverlay.Bounds.Height,
                                     Converter={x:Static conv:AttachmentHeightToPaddingConverter.Instance}}"
                   Background="Transparent" CornerRadius="12"
                   BorderBrush="Transparent" BorderThickness="0"
                   VerticalContentAlignment="Top">
            <TextBox.KeyBindings>
              <KeyBinding Gesture="Enter" Command="{Binding SendFromKeyboardCommand}" />
            </TextBox.KeyBindings>
          </TextBox>

          <!-- 附件区：浮在 TextBox 顶部；无附件时高度为 0，TextBox 顶部 Padding 恢复 10 -->
          <StackPanel Name="AttachmentOverlay"
                      VerticalAlignment="Top"
                      Margin="10,8,10,10"
                      Spacing="4">
            <ItemsControl ItemsSource="{Binding AttachmentNames}">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate><WrapPanel Orientation="Horizontal"/></ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Border Margin="0,0,8,4" Padding="7,4" Background="#F2F4F7" CornerRadius="8">
                    <StackPanel Orientation="Horizontal" Spacing="5">
                      <materialIcons:MaterialIcon Kind="{x:Static icons:MaterialIconKind.Paperclip}"
                                                  Width="12" Height="12" Foreground="#667085"
                                                  VerticalAlignment="Center"/>
                      <TextBlock Text="{Binding}" Foreground="#344054" FontSize="12"
                                 VerticalAlignment="Center"/>
                      <Button ToolTip.Tip="移除附件"
                              Command="{Binding $parent[Window].DataContext.Chat.RemoveAttachmentCommand}"
                              CommandParameter="{Binding}" Padding="0" Width="18" Height="18"
                              Background="Transparent" BorderThickness="0"
                              VerticalAlignment="Center">
                        <materialIcons:MaterialIcon Kind="{x:Static icons:MaterialIconKind.Close}"
                                                    Width="12" Height="12"/>
                      </Button>
                    </StackPanel>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>

            <TextBlock Text="{Binding AttachmentHint}" FontSize="12" Foreground="#B42318"
                       TextWrapping="Wrap" IsVisible="{Binding HasAttachmentHint}"/>
          </StackPanel>

          <!-- 输入提示：浮在工具栏上方右下 -->
          <TextBlock Text="Enter 发送 · Shift+Enter 换行"
                     FontSize="10" Foreground="#98A2B3"
                     HorizontalAlignment="Right" VerticalAlignment="Top"
                     Margin="0,10,16,40"
                     IsHitTestVisible="False"/>

          <!-- 工具栏：浮在 TextBox 底部，始终贴底 -->
          <Grid VerticalAlignment="Bottom" Margin="10,0,10,8"
                ColumnDefinitions="Auto,Auto,Auto,*,Auto">
            <Button Grid.Column="0" ToolTip.Tip="添加附件" Command="{Binding AddAttachmentsCommand}"
                    IsEnabled="{Binding CanChangeConversation}" Width="34" Height="32" Padding="7"
                    Background="Transparent" BorderThickness="0">
              <materialIcons:MaterialIcon Kind="{x:Static icons:MaterialIconKind.Paperclip}"
                                          Width="18" Height="18"/>
            </Button>

            <Button Grid.Column="1" ToolTip.Tip="高级生成配置" Command="{Binding ToggleAdvancedCommand}"
                    IsEnabled="{Binding CanChangeConversation}" Width="34" Height="32"
                    Padding="7" Background="Transparent" BorderThickness="0">
              <materialIcons:MaterialIcon Kind="{x:Static icons:MaterialIconKind.Tune}"
                                          Width="18" Height="18"/>
            </Button>

            <ComboBox Grid.Column="2" Width="150" Height="28" MinHeight="28"
                      VerticalAlignment="Center" Margin="6,0"
                      FontSize="12" Padding="8,0,26,0" CornerRadius="8"
                      Background="#F9FAFB" BorderBrush="#E4E7EC" BorderThickness="1"
                      ItemsSource="{Binding InstalledModels}"
                      SelectedItem="{Binding SelectedModel}" PlaceholderText="选择模型"
                      IsEnabled="{Binding CanChangeConversation}">
              <ComboBox.ItemTemplate>
                <DataTemplate>
                  <TextBlock Text="{Binding Title}" FontSize="12" Foreground="#344054"
                             TextTrimming="CharacterEllipsis"/>
                </DataTemplate>
              </ComboBox.ItemTemplate>
            </ComboBox>

            <CheckBox Grid.Column="3" Content="思考模式" IsChecked="{Binding IsThinking}"
                      VerticalAlignment="Center" Margin="6,0" HorizontalAlignment="Left"
                      IsEnabled="{Binding CanChangeConversation}"/>

            <StackPanel Grid.Column="4" Orientation="Horizontal" Spacing="4"
                        VerticalAlignment="Center">
              <TextBlock Text="{Binding StatusText}" VerticalAlignment="Center"
                         Margin="0,0,8,0" MaxWidth="220" FontSize="12" Foreground="#667085"
                         TextTrimming="CharacterEllipsis"/>
              <Button ToolTip.Tip="发送" Command="{Binding SendCommand}"
                      IsVisible="{Binding CanShowSend}" IsEnabled="{Binding CanSend}"
                      Width="36" Height="32" Padding="7" CornerRadius="8">
                <materialIcons:MaterialIcon Kind="{x:Static icons:MaterialIconKind.Send}"
                                            Width="18" Height="18"/>
              </Button>
              <Button ToolTip.Tip="停止生成" Command="{Binding StopGenerationCommand}"
                      IsVisible="{Binding CanStop}" Background="#D92D20" Foreground="White"
                      Width="36" Height="32" Padding="7" CornerRadius="8">
                <materialIcons:MaterialIcon Kind="{x:Static icons:MaterialIconKind.Stop}"
                                            Width="18" Height="18"/>
              </Button>
            </StackPanel>
          </Grid>
        </Grid>
      </Border>
      <!-- ========== 输入区结束 ========== -->

      <!-- 高级配置弹窗 -->
      <Border IsVisible="{Binding IsAdvancedOpen}" Grid.RowSpan="2" Background="#990F172A"
              HorizontalAlignment="Stretch" VerticalAlignment="Stretch" ZIndex="10">
        <Border Width="560" MaxHeight="680" Background="White" CornerRadius="16"
                BoxShadow="0 24 64 0 #33101828"
                HorizontalAlignment="Center" VerticalAlignment="Center">
          <Grid RowDefinitions="Auto,*,Auto">
            <Border Grid.Row="0" Padding="24,20,16,16"
                    BorderBrush="#EAECF0" BorderThickness="0,0,0,1">
              <Grid ColumnDefinitions="*,Auto">
                <StackPanel Spacing="4" VerticalAlignment="Center">
                  <TextBlock Text="生成参数" FontSize="18" FontWeight="SemiBold" Foreground="#101828"/>
                  <TextBlock Text="调整当前对话的生成行为，修改将应用于后续消息。"
                             FontSize="12" Foreground="#667085" TextWrapping="Wrap"/>
                </StackPanel>
                <Button Grid.Column="1" Command="{Binding CloseAdvancedCommand}"
                        Width="32" Height="32" Padding="0" FontSize="18"
                        Background="Transparent" BorderThickness="0" Foreground="#667085"
                        HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                        VerticalAlignment="Top" ToolTip.Tip="关闭">
                  <materialIcons:MaterialIcon Kind="{x:Static icons:MaterialIconKind.Close}"
                                              Width="18" Height="18"/>
                </Button>
              </Grid>
            </Border>
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
              <StackPanel Margin="24,20,20,20" Spacing="18">
                <Grid ColumnDefinitions="120,*" ColumnSpacing="16"
                      RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto" RowSpacing="12">
                  <TextBlock Text="输出长度" VerticalAlignment="Center" FontSize="13" Foreground="#344054"/>
                  <NumericUpDown Grid.Column="1" Value="{Binding MaxNewTokens}" Minimum="1" Maximum="8192"/>
                  <TextBlock Grid.Row="1" Text="温度" VerticalAlignment="Center" FontSize="13" Foreground="#344054"/>
                  <NumericUpDown Grid.Row="1" Grid.Column="1" Value="{Binding Temperature}" Minimum="0" Maximum="2" Increment="0.05"/>
                  <TextBlock Grid.Row="2" Text="Top P" VerticalAlignment="Center" FontSize="13" Foreground="#344054"/>
                  <NumericUpDown Grid.Row="2" Grid.Column="1" Value="{Binding TopP}" Minimum="0" Maximum="1" Increment="0.05"/>
                  <TextBlock Grid.Row="3" Text="Top K" VerticalAlignment="Center" FontSize="13" Foreground="#344054"/>
                  <NumericUpDown Grid.Row="3" Grid.Column="1" Value="{Binding TopK}" Minimum="0" Maximum="200"/>
                  <TextBlock Grid.Row="4" Text="重复惩罚" VerticalAlignment="Center" FontSize="13" Foreground="#344054"/>
                  <NumericUpDown Grid.Row="4" Grid.Column="1" Value="{Binding RepetitionPenalty}" Minimum="0.1" Maximum="2" Increment="0.05"/>
                  <TextBlock Grid.Row="5" Text="思考预算" VerticalAlignment="Center" FontSize="13" Foreground="#344054"/>
                  <NumericUpDown Grid.Row="5" Grid.Column="1" Value="{Binding ThinkingBudget}" Minimum="0" Maximum="8192"/>
                  <TextBlock Grid.Row="6" Text="历史轮数" VerticalAlignment="Center" FontSize="13" Foreground="#344054"/>
                  <NumericUpDown Grid.Row="6" Grid.Column="1" Value="{Binding MaxHistoryTurns}" Minimum="0" Maximum="20"/>
                </Grid>
                <Border Height="1" Background="#F2F4F7"/>
                <StackPanel Spacing="10">
                  <CheckBox Content="启用采样" IsChecked="{Binding DoSample}"/>
                  <CheckBox Content="流式显示输出" IsChecked="{Binding StreamOutput}"/>
                </StackPanel>
              </StackPanel>
            </ScrollViewer>
            <Border Grid.Row="2" Padding="24,14,24,16"
                    BorderBrush="#EAECF0" BorderThickness="0,1,0,0"
                    Background="#F9FAFB" CornerRadius="0,0,16,16">
              <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="10">
                <Button Content="取消" Command="{Binding CloseAdvancedCommand}" Padding="18,8"
                        Background="Transparent" BorderBrush="#D0D5DD" Foreground="#344054"/>
                <Button Content="完成" Command="{Binding CloseAdvancedCommand}" Padding="22,8"
                        Background="#175CD3" Foreground="White" BorderThickness="0"/>
              </StackPanel>
            </Border>
          </Grid>
        </Border>
      </Border>

    </Grid>
  </Grid>
</UserControl>