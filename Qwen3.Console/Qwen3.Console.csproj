<Project Sdk="Microsoft.NET.Sdk">
		<PropertyGroup>
				<!-- 基础元信息 -->
				<AssemblyName>Qwen3.Console</AssemblyName>
				<RootNamespace>Qwen3.Console</RootNamespace>
				<Title>Qwen3 Console</Title>
				<Description>Console demo for Qwen3 ONNX inference</Description>

				<OutputType>Exe</OutputType>
				<TargetFramework>net8.0</TargetFramework>
				<ImplicitUsings>enable</ImplicitUsings>
				<Nullable>enable</Nullable>
		</PropertyGroup>

		<ItemGroup>
				<ProjectReference Include="..\Qwen3.Inference\Qwen3.Inference.csproj" />
		</ItemGroup>

		<!-- 显式指定两个模型文件夹，目录内所有文件递归复制 -->
		<ItemGroup>
				<None Update="models\Qwen3-0.6B-int4-onnx\**\*">
						<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
				</None>
				<None Update="models\Qwen3-0.6B-int8-onnx\**\*">
						<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
				</None>
		</ItemGroup>
</Project>
